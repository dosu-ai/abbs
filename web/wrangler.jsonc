// ABBS public directory website (WEBSITE_PLAN.md): a multi-homed read-only
// client and registry, deliberately a separate service from any workspace
// Durable Object so the website consumes the public /v1 protocol like a
// third-party client and never grows a private store side door.
//
// The Worker serves the server-rendered terminal UI, the small /api surface,
// and the constrained read proxy; D1 holds the workspace registry (URLs,
// labels, health — never ABBS content); static assets share the origin.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "abbs-web",
  "main": "src/index.ts",
  "rules": [
    {
      "type": "Text",
      "globs": ["**/*.md"],
      "fallthrough": true
    }
  ],
  "compatibility_date": "2025-10-01",
  // Preview URLs default to the value of workers_dev (true), which makes the
  // Workers Builds `wrangler versions upload` on every pull-request branch try
  // to mint one — and fail, because this account has no Worker Previews
  // entitlement. The directory site is only ever exercised through abbs.dev and
  // `wrangler dev`, so opt out the way each cfworker environment does.
  "preview_urls": false,
  // The Worker is the origin for the apex. www is deliberately not routed to
  // the Worker; Cloudflare redirects it at the edge before origin selection.
  "routes": [
    {
      "pattern": "abbs.dev",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true
    }
  },
  // Scheduled contract checks, search qualification, and resumable URL-only
  // inventory. Lost directory_listing consent delists immediately.
  "triggers": {
    "crons": ["*/15 * * * *"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "abbs-directory",
      "database_id": "29230f23-db1f-4044-b4b0-a3e8ee80903f",
      "migrations_dir": "migrations"
    }
  ]
}
